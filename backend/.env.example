SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# Production defaults to console logs; local DEBUG=True also writes rotating files.
# LOG_TO_FILE=False

# Leave unset to use local SQLite. For Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/yardly
# Neon: use the PostgreSQL connection string from Connect, not the Neon API key.
# DATABASE_URL=postgresql://ROLE:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email configuration. Local development saves messages in backend/emails/.
FRONTEND_URL=http://localhost:5173
# Leave EMAIL_BACKEND unset to capture locally until RESEND_API_KEY is set.
# EMAIL_BACKEND=apps.common.resend_backend.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Yardly <noreply@yardly.local>
# For Resend, set RESEND_API_KEY and DEFAULT_FROM_EMAIL to a verified sender.
# SMTP is also supported via django.core.mail.backends.smtp.EmailBackend
# and set your provider's verified sender and credentials below.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
